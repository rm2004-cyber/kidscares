{
  "name": "kidscare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --prefix server run dev",
    "dev:web": "wait-on -t 60000 http-get://127.0.0.1:${API_PORT:-${PORT:-5001}}/api/health && next dev",
    "build": "next build",
    "start": "concurrently -k -n API,WEB -c magenta,cyan \"npm:start:api\" \"npm:start:web\"",
    "start:api": "npm --prefix server start",
    "start:web": "wait-on -t 60000 http-get://127.0.0.1:${API_PORT:-${PORT:-5001}}/api/health && next start",
    "server": "npm --prefix server start",
    "build:email-backdrop": "node --experimental-strip-types scripts/build-email-backdrop.mjs",
    "seed": "npm --prefix server run seed",
    "seed:fresh": "npm --prefix server run seed -- --fresh",
    "install:all": "npm install && npm --prefix server install",
    "lint": "eslint",
    "build:logos": "node scripts/tighten-logo.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.32.0",
    "motion": "^13.1.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  }
}
